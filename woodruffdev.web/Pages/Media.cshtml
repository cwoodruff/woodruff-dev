@page
@using WoodruffDev.Models
@model WoodruffDev.Pages.MediaModel
@{
    ViewData["Title"] = "Media";
}

<div class="page-header">
    <div class="container">
        <span class="section-label">Media</span>
        <h1>Podcasts, videos &amp; guest articles</h1>
        <p>Conversations I&rsquo;ve hosted or joined, talks I&rsquo;ve given, and articles published on other sites.</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="filter-tabs fade-in" role="tablist" aria-label="Media filters">
            <button class="filter-tab active" data-filter="all" role="tab" aria-selected="true">All</button>
            <button class="filter-tab" data-filter="podcasts" role="tab" aria-selected="false">Podcasts</button>
            <button class="filter-tab" data-filter="videos" role="tab" aria-selected="false">Videos</button>
            <button class="filter-tab" data-filter="articles" role="tab" aria-selected="false">Articles</button>
        </div>

        @if (Model.Items.Count == 0)
        {
            <p style="text-align:center; color: var(--ink-muted); margin: var(--space-xl) 0;">
                New appearances coming soon.
            </p>
        }
        else
        {
            <div class="media-grid">
                @foreach (var item in Model.Items)
                {
                    <a href="@item.Url" class="media-card fade-in" data-type="@item.FilterKey"
                       target="_blank" rel="noopener">
                        <div class="media-card-body">
                            <div class="media-card-meta">
                                <span class="blog-card-tag">@item.TypeLabel</span>
                                <span class="media-card-outlet">@item.Outlet</span>
                                @if (item.Date is not null)
                                {
                                    <span class="media-card-date">@item.Date.Value.ToString("MMM yyyy")</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Duration))
                                {
                                    <span class="media-card-duration">@item.Duration</span>
                                }
                            </div>
                            <h3>@item.Title <span class="external-indicator" aria-hidden="true">&#8599;</span></h3>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <p>@Html.Raw(item.Description)</p>
                            }
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</section>

@section Scripts {
<script>
    document.querySelectorAll('.filter-tab').forEach(tab => {
        tab.addEventListener('click', () => {
            const filter = tab.dataset.filter;
            document.querySelectorAll('.filter-tab').forEach(t => {
                t.classList.remove('active');
                t.setAttribute('aria-selected', 'false');
            });
            tab.classList.add('active');
            tab.setAttribute('aria-selected', 'true');
            document.querySelectorAll('.media-card[data-type]').forEach(card => {
                card.style.display = (filter === 'all' || card.dataset.type === filter) ? '' : 'none';
            });
        });
    });
</script>
}
