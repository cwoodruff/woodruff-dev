@page "/Blog/{slug}"
@model WoodruffDev.Pages.BlogPostModel
@{
    ViewData["Title"] = Model.Post.Title;
}

<article class="blog-post-detail">
    <div class="container">
        <nav class="blog-post-nav">
            <a href="/Blog">&larr; Back to Blog &amp; Insights</a>
        </nav>

        <header class="blog-post-header">
            <span class="section-label">@Model.Post.Category</span>
            <h1>@Model.Post.Title</h1>
            @if (!string.IsNullOrEmpty(Model.Post.Subtitle))
            {
                <p class="blog-post-subtitle">@Model.Post.Subtitle</p>
            }
            <time class="blog-post-date" datetime="@Model.Post.PublishedDate.ToString("yyyy-MM-dd")">
                @Model.Post.PublishedDate.ToString("MMMM d, yyyy")
            </time>
        </header>

        <div class="blog-post-feature-img">
            <img src="@Model.Post.FeatureImagePath" alt="@Model.Post.Title"
                 onerror="this.parentElement.innerHTML='<div style=\'display:flex;align-items:center;justify-content:center;height:100%;font-size:4rem;color:#c9a96e\'>&#128221;</div>'" />
        </div>

        <div class="blog-post-content">
            @Html.Raw(Model.Post.HtmlContent)
        </div>

        <nav class="blog-post-nav blog-post-nav-bottom">
            <a href="/Blog">&larr; Back to Blog &amp; Insights</a>
        </nav>
    </div>
</article>
