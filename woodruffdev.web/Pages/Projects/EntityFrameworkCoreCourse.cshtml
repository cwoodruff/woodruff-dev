@page
@model WoodruffDev.Pages.Projects.EntityFrameworkCoreCourseModel
@{
    ViewData["Title"] = "Entity Framework Core Course";
}

<div class="page-header">
    <div class="container">
        <span class="section-label">Course</span>
        <h1>Entity Framework Core Course</h1>
        <p>A comprehensive course on mastering data access with Entity Framework Core.</p>
    </div>
</div>

<section class="section">
    <div class="container">
