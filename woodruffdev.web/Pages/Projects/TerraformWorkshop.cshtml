@page
@model WoodruffDev.Pages.Projects.TerraformWorkshopModel
@{
    ViewData["Title"] = "Terraform Workshop";
}

<div class="page-header">
    <div class="container">
        <span class="section-label">Workshop</span>
        <h1>Terraform Workshop</h1>
        <p>A hands-on workshop for building and managing cloud infrastructure with Terraform.</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="service-detail fade-in">
            <h2>Project Overview</h2>
            <p>This workshop teaches developers and DevOps engineers how to define, provision, and manage cloud infrastructure using Terraform. Through practical exercises, participants gain confidence in infrastructure as code and learn patterns that scale from small projects to enterprise environments.</p>

            <h2>What You&rsquo;ll Learn</h2>
            <ul>
                <li>Terraform fundamentals and HCL syntax</li>
                <li>Provisioning and managing cloud resources</li>
                <li>State management and collaboration workflows</li>
                <li>Modules, variables, and reusable infrastructure patterns</li>
            </ul>

            <div class="service-nav">
                <a href="/Projects/HtmxRazorPagesWorkshop">&larr; htmx &amp; Razor Pages Workshop</a>
                <a href="/Projects/AspNetCoreHtmxBook">ASP.NET Core Reimagined with htmx &rarr;</a>
            </div>
        </div>
    </div>
</section>
