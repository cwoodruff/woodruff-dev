@page
@model WoodruffDev.Pages.Projects.HtmxRazorPagesWorkshopModel
@{
    ViewData["Title"] = "htmx & Razor Pages Workshop";
}

<div class="page-header">
    <div class="container">
        <span class="section-label">Workshop</span>
        <h1>htmx &amp; Razor Pages Workshop</h1>
        <p>A hands-on workshop for building dynamic web applications with htmx and ASP.NET Core Razor Pages.</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="service-detail fade-in">
            <h2>Project Overview</h2>
            <p>This workshop gives developers hands-on experience combining htmx with ASP.NET Core Razor Pages. Participants learn how to build interactive, server-driven web applications that feel modern and responsive&mdash;without reaching for complex JavaScript frameworks.</p>

            <h2>What You&rsquo;ll Learn</h2>
            <ul>
                <li>Core htmx concepts and how they integrate with Razor Pages</li>
                <li>Building interactive forms, search, and filtering</li>
                <li>Partial page updates and server-sent events</li>
                <li>Real-world patterns for production applications</li>
            </ul>

            <div class="service-nav">
                <a href="/Projects/EntityFrameworkCoreCourse">&larr; Entity Framework Core Course</a>
                <a href="/Projects/TerraformWorkshop">Terraform Workshop &rarr;</a>
            </div>
        </div>
    </div>
</section>
