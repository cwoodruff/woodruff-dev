@page
@model WoodruffDev.Pages.Projects.AspNetCoreHtmxBookModel
@{
    ViewData["Title"] = "ASP.NET Core Reimagined with htmx";
}

<div class="page-header">
    <div class="container">
        <span class="section-label">Book</span>
        <h1>ASP.NET Core Reimagined with htmx</h1>
        <p>A practical guide to building modern web applications with ASP.NET Core and htmx.</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="service-detail fade-in">
            <h2>Project Overview</h2>
            <p>This book explores how htmx can transform the way you build ASP.NET Core web applications. By leveraging hypermedia-driven interactions, you can create rich, dynamic user experiences without the complexity of heavy JavaScript frameworks.</p>

            <h2>What You&rsquo;ll Learn</h2>
            <ul>
                <li>How to integrate htmx with ASP.NET Core Razor Pages</li>
                <li>Building dynamic, interactive UIs with minimal JavaScript</li>
                <li>Leveraging hypermedia as the engine of application state</li>
                <li>Practical patterns for real-world web applications</li>
            </ul>

            <div class="service-nav">
                <a href="/Projects/TerraformWorkshop">&larr; Terraform Workshop</a>
                <a href="/Projects/BreakpointShow">The Breakpoint Show &rarr;</a>
            </div>
        </div>
    </div>
</section>
