                        <a href="https://simplicity-first.dev/" target="_blank" rel="noopener">Simplicity-First <span class="external-indicator">&#8599;</span></a>
                        <a href="/AgenticRelations">Agentic Relations</a>
                    </div>
                </div>
                <a href="/About">About</a>
