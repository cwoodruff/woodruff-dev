@page
@using WoodruffDev.Models
@model WoodruffDev.Pages.PortfolioModel
@{
    ViewData["Title"] = "Portfolio";
}

<div class="page-header">
    <div class="container">
        <span class="section-label">Portfolio</span>
        <h1>Open source &amp; writing</h1>
        <p>Code I&rsquo;ve shipped, books I&rsquo;ve written, and courses &amp; workshops I&rsquo;ve built over the years.</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="filter-tabs fade-in" role="tablist" aria-label="Portfolio filters">
            <button class="filter-tab active" data-filter="all" role="tab" aria-selected="true">All</button>
            <button class="filter-tab" data-filter="open-source" role="tab" aria-selected="false">Open Source</button>
            <button class="filter-tab" data-filter="writing" role="tab" aria-selected="false">Writing</button>
        </div>

        <div class="projects-grid">
            @foreach (var item in Model.Items)
            {
                var filterClass = item.Category == PortfolioCategory.OpenSource ? "open-source" : "writing";
                var target = item.IsExternal ? "_blank" : null;
                var rel = item.IsExternal ? "noopener" : null;
                <a href="@item.Href" class="project-card fade-in" data-category="@filterClass"
                   target="@target" rel="@rel">
                    <div class="project-card-img">
                        <img src="@item.ImagePath" alt="@item.Title"
                             onerror="this.parentElement.innerHTML='<div style=\'display:flex;align-items:center;justify-content:center;height:100%;font-size:2.5rem;color:#c9a96e\'>&#128221;</div>'" />
                    </div>
                    <div class="project-card-body">
                        <span class="project-card-type">
                            @item.CategoryLabel
                            @if (item.IsExternal)
                            {
                                <span class="external-indicator" aria-label="External link">&#8599;</span>
                            }
                        </span>
                        <h3>@item.Title</h3>
                        <p class="project-card-desc">@item.Description</p>
                        @if (item.Tech.Length > 0)
                        {
                            <div class="project-card-tech">
                                @foreach (var tech in item.Tech)
                                {
                                    <span class="tech-chip">@tech</span>
                                }
                            </div>
                        }
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <span class="section-label">Let&rsquo;s Connect</span>
        <h2>Got an idea worth building?</h2>
        <p>If any of this work resonates, let&rsquo;s talk about what we could build together.</p>
        <a href="/Contact" class="btn btn-primary">Get In Touch <span class="btn-arrow">&rarr;</span></a>
    </div>
</section>

@section Scripts {
<script>
    document.querySelectorAll('.filter-tab').forEach(tab => {
        tab.addEventListener('click', () => {
            const filter = tab.dataset.filter;
            document.querySelectorAll('.filter-tab').forEach(t => {
                t.classList.remove('active');
                t.setAttribute('aria-selected', 'false');
            });
            tab.classList.add('active');
            tab.setAttribute('aria-selected', 'true');
            document.querySelectorAll('.project-card[data-category]').forEach(card => {
                card.style.display = (filter === 'all' || card.dataset.category === filter) ? '' : 'none';
            });
        });
    });
</script>
}
