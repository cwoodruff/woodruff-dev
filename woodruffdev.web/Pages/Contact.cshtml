@page
@model WoodruffDev.Pages.ContactModel
@{
    ViewData["Title"] = "Contact";
}

<div class="page-header">
    <div class="container">
        <span class="section-label">Contact</span>
        <h1>Get In Touch</h1>
        <p>I will respond to your request within 24 hours.</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="contact-grid">
            <div class="contact-info fade-in">
                <h2>Let&rsquo;s work together</h2>
                <p>Whether in the boardroom or the courtroom, I bring clarity to complex software challenges&mdash;and help people make better decisions through better understanding.</p>
                <div style="margin-top: var(--space-lg);">
                    <div class="contact-detail">
                        <div class="contact-detail-icon">&#128222;</div>
                        <div>
                            <strong>Phone</strong><br />
                            <a href="tel:+16167246885" style="color: var(--ink-muted);">+1 616.724.6885</a>
                        </div>
                    </div>
                    <div class="contact-detail">
                        <div class="contact-detail-icon">&#128231;</div>
                        <div>
                            <strong>Email</strong><br />
                            <a href="mailto:chris@woodruff.dev" style="color: var(--ink-muted);">chris@woodruff.dev</a>
                        </div>
                    </div>
                    <div class="contact-detail">
                        <div class="contact-detail-icon">&#128205;</div>
                        <div>
                            <strong>Address</strong><br />
                            <span style="color: var(--ink-muted);">Wyoming, MI 49418</span>
                        </div>
                    </div>
                </div>
                <div style="margin-top: var(--space-xl);">
                    <h4>Connect</h4>
                    <div class="hero-social" style="margin-top: var(--space-sm);">
                        <a href="https://www.linkedin.com/in/chriswoodruff/" target="_blank" rel="noopener" aria-label="LinkedIn">
                            <svg viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                        </a>
                        <a href="https://github.com/cwoodruff" target="_blank" rel="noopener" aria-label="GitHub">
                            <svg viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                        </a>
                        <a href="https://www.youtube.com/@@ChrisWoodruff" target="_blank" rel="noopener" aria-label="YouTube">
                            <svg viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                        </a>
                    </div>
                </div>
            </div>
            <form class="contact-form fade-in" id="contact-form" method="post">
                @if (Model.FormSubmitted)
                {
                    <div style="background: #e8f5e9; border: 1px solid #a5d6a7; border-radius: var(--radius); padding: 1.25rem; margin-bottom: var(--space-md); color: #2e7d32;">
                        <strong>Message sent!</strong> Thank you for reaching out. I&rsquo;ll respond within 24 hours.
                    </div>
                }
                <h3 style="margin-bottom: var(--space-md);">Send a Message</h3>
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Input.Name">Name *</label>
                        <input asp-for="Input.Name" placeholder="Your full name" />
                        <span asp-validation-for="Input.Name" style="color:#c62828;font-size:0.8rem;"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Input.Email">Email *</label>
                        <input asp-for="Input.Email" placeholder="you@example.com" />
                        <span asp-validation-for="Input.Email" style="color:#c62828;font-size:0.8rem;"></span>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Input.Phone">Phone</label>
                        <input asp-for="Input.Phone" placeholder="+1 555.123.4567" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Input.Company">Company</label>
                        <input asp-for="Input.Company" placeholder="Your company" />
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Subject">Subject *</label>
                    <select asp-for="Input.Subject">
                        <option value="">Your inquiry about&hellip;</option>
                        <option value="Fractional Leadership">Fractional Leadership</option>
                        <option value="Advisory & Board Roles">Advisory &amp; Board Roles</option>
                        <option value="Consulting">Consulting</option>
                        <option value="Legal Work">Legal Work</option>
                    </select>
                    <span asp-validation-for="Input.Subject" style="color:#c62828;font-size:0.8rem;"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Message">Message (optional)</label>
                    <textarea asp-for="Input.Message" placeholder="Tell me about your project or challenge&hellip;"></textarea>
                </div>
                <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center;">Send Message <span class="btn-arrow">&rarr;</span></button>
            </form>
        </div>
    </div>
</section>
