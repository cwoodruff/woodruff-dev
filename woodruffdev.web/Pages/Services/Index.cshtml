@page
@model WoodruffDev.Pages.Services.IndexModel
@{
    ViewData["Title"] = "Services";
}

<div class="page-header">
    <div class="container">
        <span class="section-label">Services</span>
        <h1>Essential Services</h1>
        <p>Senior technical leadership, forensic analysis, and developer-relations programs&mdash;shaped to the decision in front of you.</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="services-grid">
            <div class="service-card fade-in">
                <span class="service-num">01</span>
                <h3>Fractional Architect</h3>
                <p>Senior architecture leadership, embedded in your team 4&ndash;16 hours per week. Decisions with receipts, engineers who grow, and a 90-day technical roadmap you can share with the board.</p>
                <a href="/Services/FractionalArchitect" class="service-link">Service Details <span class="btn-arrow">&rarr;</span></a>
            </div>
            <div class="service-card fade-in">
                <span class="service-num">02</span>
                <h3>Software Forensic Expert Witness</h3>
                <p>Defensible technical analysis for litigation&mdash;contract, IP, negligence, and M&amp;A disputes. Reports built for Daubert, testimony that holds up under cross-examination.</p>
                <a href="/Services/ExpertWitness" class="service-link">Service Details <span class="btn-arrow">&rarr;</span></a>
            </div>
            <div class="service-card fade-in">
                <span class="service-num">03</span>
                <h3>Micro-Consulting</h3>
                <p>A 90-minute deep-dive plus a written decision brief&mdash;for the single sharp question your team needs answered this week, not next quarter.</p>
                <a href="/Services/MicroConsulting" class="service-link">Service Details <span class="btn-arrow">&rarr;</span></a>
            </div>
            <div class="service-card fade-in">
                <span class="service-num">04</span>
                <h3>Project-Based Contracts</h3>
                <p>Scoped, fixed-fee engagements for architecture assessments, modernization plans, cloud migrations, and technical due diligence. Owned end-to-end, with a clean handoff.</p>
                <a href="/Services/ProjectBased" class="service-link">Service Details <span class="btn-arrow">&rarr;</span></a>
            </div>
            <div class="service-card fade-in">
                <span class="service-num">05</span>
                <h3>Developer Relations Services</h3>
                <p>DX audits, content strategy, conference programs, community building, and DevRel team design&mdash;for platforms that need developers to choose them, stay, and tell other developers.</p>
                <a href="/Services/DevRel" class="service-link">Service Details <span class="btn-arrow">&rarr;</span></a>
            </div>
            <div class="service-card fade-in">
                <span class="service-num">06</span>
                <h3>Advisory &amp; Board Roles</h3>
                <p>An independent technical voice for boards, founders, and PE operators&mdash;pressure-testing roadmaps, surfacing risk, and making trade-offs visible before the vote.</p>
                <a href="/Services/Advisory" class="service-link">Service Details <span class="btn-arrow">&rarr;</span></a>
            </div>
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <span class="section-label">Ready to start?</span>
        <h2>Let&rsquo;s solve what&rsquo;s slowing you down.</h2>
        <p>Whether you need a fractional architect, expert witness, developer-relations lead, or strategic advisor&mdash;let&rsquo;s talk about the decision in front of you.</p>
        <a href="/Contact" class="btn btn-primary">Get In Touch <span class="btn-arrow">&rarr;</span></a>
    </div>
</section>
