@page
@model WoodruffDev.Pages.Services.IndexModel
@{
    ViewData["Title"] = "Services";
}

<div class="page-header">
    <div class="container">
        <span class="section-label">Services</span>
        <h1>Essential Services</h1>
        <p>Strategic technology leadership and expert guidance, exactly when and where it&rsquo;s needed.</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="services-grid">
            <div class="service-card fade-in">
                <span class="service-num">01</span>
                <h3>Fractional Architect</h3>
                <p>High-impact software architecture when and how you need it. Technical leadership, platform strategy, and architectural clarity&mdash;on a flexible schedule and at a fraction of the cost of a permanent hire.</p>
                <a href="/Services/FractionalArchitect" class="service-link">Service Details <span class="btn-arrow">&rarr;</span></a>
            </div>
            <div class="service-card fade-in">
                <span class="service-num">02</span>
                <h3>Software Forensic Expert Witness</h3>
                <p>Clear, objective software analysis&mdash;when the stakes are high. In-depth technical analysis, expert reports, and courtroom-ready insights that attorneys and judges can trust.</p>
                <a href="/Services/ExpertWitness" class="service-link">Service Details <span class="btn-arrow">&rarr;</span></a>
            </div>
            <div class="service-card fade-in">
                <span class="service-num">03</span>
                <h3>Micro-Consulting</h3>
                <p>Fast, focused sessions to resolve architecture questions, performance issues, or critical forks in the road. One hour. One problem. Real answers.</p>
                <a href="/Services/MicroConsulting" class="service-link">Service Details <span class="btn-arrow">&rarr;</span></a>
            </div>
            <div class="service-card fade-in">
                <span class="service-num">04</span>
                <h3>Project-Based Contracts</h3>
                <p>I lead and execute focused architecture and modernization efforts with start-to-finish accountability. Clear deliverables, defined outcomes, real momentum.</p>
                <a href="/Services/ProjectBased" class="service-link">Service Details <span class="btn-arrow">&rarr;</span></a>
            </div>
            <div class="service-card fade-in">
                <span class="service-num">05</span>
                <h3>Retainer-Based Services</h3>
                <p>Ongoing architecture support, available when your team needs clarity, feedback, or direction. Trusted guidance on call&mdash;because tech challenges don&rsquo;t follow a schedule.</p>
                <a href="/Services/Retainer" class="service-link">Service Details <span class="btn-arrow">&rarr;</span></a>
            </div>
            <div class="service-card fade-in">
                <span class="service-num">06</span>
                <h3>Advisory &amp; Board Roles</h3>
                <p>I advise leadership teams on platform evolution, scaling, technical risk, and innovation. Strategic tech insight where it matters most&mdash;at the decision table.</p>
                <a href="/Services/Advisory" class="service-link">Service Details <span class="btn-arrow">&rarr;</span></a>
            </div>
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <span class="section-label">Ready to start?</span>
        <h2>Let&rsquo;s solve what&rsquo;s slowing you down.</h2>
        <p>Whether you need a fractional architect, expert witness, or strategic advisor&mdash;I&rsquo;m here to help.</p>
        <a href="/Contact" class="btn btn-primary">Get In Touch <span class="btn-arrow">&rarr;</span></a>
    </div>
</section>
