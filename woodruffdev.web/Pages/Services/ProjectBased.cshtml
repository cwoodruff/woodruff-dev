@page
@model WoodruffDev.Pages.Services.ProjectBasedModel
@{
    ViewData["Title"] = "Project-Based Contracts";
}

<div class="page-header">
    <div class="container">
        <span class="section-label">Service</span>
        <h1>Project-Based Contracts</h1>
        <p>Clear deliverables, defined outcomes, real momentum.</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="service-detail fade-in">
            <h2>Service Overview</h2>
            <p>I lead and execute focused architecture and modernization efforts with start-to-finish accountability. When you need more than advice&mdash;you need someone to own a defined piece of technical work and deliver it&mdash;this is the engagement model that fits.</p>

            <h2>Common Project Types</h2>
            <ul>
                <li>Architecture assessments and modernization roadmaps</li>
                <li>Cloud migration planning and execution guidance</li>
                <li>API design and implementation frameworks</li>
                <li>Legacy system decomposition strategies</li>
                <li>Performance audits with actionable recommendations</li>
                <li>Technical due diligence for acquisitions or partnerships</li>
            </ul>

            <h2>How It Works</h2>
            <p>We scope the work together, agree on deliverables and timeline, and I execute with full transparency. You get regular check-ins, documentation, and a final handoff that your team can run with.</p>

            <div class="service-nav">
                <a href="/Services/MicroConsulting">&larr; Micro-Consulting</a>
                <a href="/Services/Retainer">Retainer Services &rarr;</a>
            </div>
        </div>
    </div>
</section>
