---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'testimonials'>;
}
const { item } = Astro.props;
const { Content } = await render(item);
const initials = item.data.name
  .split(' ')
  .map((n) => n[0])
  .join('')
  .slice(0, 2);
---

<figure class="testimonial card reveal">
  <span class="testimonial__mark" aria-hidden="true">“</span>
  <blockquote class="testimonial__quote"><Content /></blockquote>
  <figcaption class="testimonial__author">
    {
      item.data.avatar ? (
        <Image class="testimonial__avatar" src={item.data.avatar} alt="" width={96} height={96} loading="lazy" />
      ) : (
        <span class="testimonial__avatar testimonial__avatar--initials" aria-hidden="true">
          {initials}
        </span>
      )
    }
    <span>
      <strong>{item.data.name}</strong>
      <span class="testimonial__role">{item.data.role}</span>
    </span>
  </figcaption>
</figure>

<style>
  .testimonial { display: flex; flex-direction: column; gap: var(--sp-30); position: relative; }
  .testimonial__mark {
    position: absolute;
    top: 0.75rem;
    right: 1.25rem;
    font-size: 5rem;
    line-height: 1;
    font-weight: 800;
    color: var(--c-accent);
    opacity: 0.5;
  }
  .testimonial__quote { font-size: var(--fs-small); line-height: 1.6; flex: 1; }
  .testimonial__quote :global(p) { max-width: none; }
  .testimonial__author { display: flex; align-items: center; gap: 0.9rem; }
  .testimonial__author > span { display: grid; line-height: 1.3; }
  .testimonial__avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .testimonial__avatar--initials {
    display: grid;
    place-items: center;
    background: var(--c-text);
    color: var(--c-white);
    font-weight: 800;
    font-size: 0.9rem;
    box-shadow: inset 0 -3px 0 var(--c-accent);
  }
  .testimonial__role { font-size: var(--fs-micro); color: var(--c-text-muted); }
</style>
