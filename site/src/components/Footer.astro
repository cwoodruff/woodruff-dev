---
import { site } from '../lib/site';
import { href } from '../lib/url';

const year = new Date().getFullYear();
const pages = [
  { label: 'Services', path: '/services/' },
  { label: 'Portfolio', path: '/portfolio/' },
  { label: 'Training', path: '/training/' },
  { label: 'Blog', path: '/blog/' },
  { label: 'Press & Media', path: '/press-media/' },
  { label: 'About', path: '/about/' },
  { label: 'Contact', path: '/contact/' },
];
const social = [
  { label: 'LinkedIn', url: site.social.linkedin },
  { label: 'GitHub', url: site.social.github },
  { label: 'YouTube', url: site.social.youtube },
  { label: 'Bluesky', url: site.social.bluesky },
  { label: 'Mastodon', url: site.social.mastodon, rel: 'noopener me' },
];
---

<footer class="site-footer section--dark">
  <div class="container">
    <div class="site-footer__top">
      <a class="brand" href={href('/')} aria-label={`${site.name}, home`}>
        <span class="brand__mark" aria-hidden="true">{site.initials}</span>
        <span class="brand__name">{site.name}</span>
      </a>
      <nav aria-label="Footer">
        <ul class="site-footer__pages" role="list">
          {pages.map((p) => (
            <li><a href={href(p.path)}>{p.label}</a></li>
          ))}
        </ul>
      </nav>
      <a class="btn btn--sm site-footer__subscribe" href={site.social.substack} target="_blank" rel="noopener">
        Subscribe <span aria-hidden="true">↗</span>
        <span class="sr-only">to the Substack (opens in a new tab)</span>
      </a>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__legal">
        <span>© {year} {site.name}</span>
        <span><a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.phoneHref}>{site.phone}</a></span>
      </p>
      <ul class="site-footer__social" role="list" aria-label="Social links">
        {social.map((s) => (
          <li><a href={s.url} target="_blank" rel={s.rel ?? 'noopener'}>{s.label}</a></li>
        ))}
        <li><a href={href('/rss.xml')}>RSS</a></li>
        <li><a href="#site-header">Top ↑</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--sp-40) var(--sp-30);
    background: var(--c-bg-dark);
    color: var(--c-text-on-dark);
  }

  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-20) var(--sp-40);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .brand__mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: var(--c-white);
    color: var(--c-text);
    font-size: 0.75rem;
    letter-spacing: -0.04em;
    box-shadow: inset 0 -3px 0 var(--c-accent);
  }
  .site-footer__pages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem var(--sp-30);
    font-size: var(--fs-tiny);
    font-weight: 600;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-10) var(--sp-20);
    margin-top: var(--sp-30);
    padding-top: var(--sp-20);
    border-top: 1px solid var(--c-border-dark);
    font-size: var(--fs-micro);
    color: var(--c-text-on-dark-muted);
  }
  .site-footer__social { display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; }
  .site-footer__legal span + span::before { content: ' · '; }

  /* Same breakpoint as the header's mobile menu: stack each row as centered lines. */
  @media (max-width: 1023px) {
    .site-footer__top,
    .site-footer__bottom { flex-direction: column; text-align: center; }
    .site-footer__pages,
    .site-footer__social { justify-content: center; }
  }
  @media (max-width: 600px) {
    .site-footer__legal span { display: block; }
    .site-footer__legal span + span::before { content: none; }
  }

  .site-footer a { transition: color var(--dur) var(--ease); }
  .site-footer__pages a:hover,
  .site-footer__bottom a:hover,
  .brand:hover { color: var(--c-accent); }
</style>
