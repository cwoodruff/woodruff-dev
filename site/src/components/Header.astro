---
import { nav, site } from '../lib/site';
import { href } from '../lib/url';

const current = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function isActive(path?: string): boolean {
  if (!path || /^https?:/.test(path)) return false;
  const full = `${base}${path}`;
  if (path === '/') return current === full || current === `${base}`;
  return current.startsWith(full);
}
---

<header class="site-header" id="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={href('/')} aria-label={`${site.name}, home`}>
      <span class="brand__mark" aria-hidden="true">{site.initials}</span>
      <span class="brand__name">Chris Woody<br />Woodruff</span>
    </a>

    <button
      class="nav-toggle"
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
    >
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Primary">
      <ul class="site-nav__list" role="list">
        {
          nav.map((item) =>
            'children' in item ? (
              <li class="site-nav__item has-children">
                {'path' in item && item.path ? (
                  <a href={href(item.path)} class:list={['site-nav__link', { 'is-active': isActive(item.path) }]}>
                    {item.label}
                  </a>
                ) : (
                  <span class="site-nav__link">{item.label}</span>
                )}
                <button
                  type="button"
                  class="site-nav__caret"
                  aria-expanded="false"
                  aria-label={`Open ${item.label} submenu`}
                >
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                    <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <ul class="site-nav__sub" role="list">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={href(child.path)}
                        class:list={['site-nav__sublink', { 'is-active': isActive(child.path) }]}
                        target={'external' in child && child.external ? '_blank' : undefined}
                        rel={'external' in child && child.external ? 'noopener' : undefined}
                      >
                        {child.label}
                        {'external' in child && child.external && (
                          <span class="ext" aria-label="opens in a new tab">
                            ↗
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="site-nav__item">
                <a href={href(item.path)} class:list={['site-nav__link', { 'is-active': isActive(item.path) }]}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <a class="btn btn--sm site-nav__cta" href={href('/contact/')}>
        Let's work <span class="arrow" aria-hidden="true">→</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease);
  }
  .site-header.is-compact {
    border-bottom-color: var(--c-border);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-40);
    min-height: var(--header-h);
    transition: min-height var(--dur) var(--ease);
  }
  .site-header.is-compact .site-header__inner {
    min-height: var(--header-h-compact);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
    font-size: 0.95rem;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .site-nav__cta { white-space: nowrap; flex-shrink: 0; }
  @media (min-width: 1024px) and (max-width: 1200px) {
    .site-nav { gap: var(--sp-20); }
    .site-nav__link { padding-inline: 0.5rem; font-size: 0.85rem; }
  }
  .brand__mark {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    background: var(--c-text);
    color: var(--c-white);
    font-size: 0.95rem;
    letter-spacing: -0.04em;
    box-shadow: inset 0 -4px 0 var(--c-accent);
  }

  /* Desktop nav */
  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--sp-40);
  }
  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .site-nav__item {
    position: relative;
    display: flex;
    align-items: center;
  }
  .site-nav__link {
    display: inline-block;
    padding: 0.5rem 0.7rem;
    font-size: 0.9rem;
    white-space: nowrap;
    font-weight: 600;
    color: var(--c-text);
    border-radius: var(--radius-pill);
    transition: background var(--dur) var(--ease);
  }
  .site-nav__link:hover,
  .site-nav__link.is-active {
    background: var(--c-bg-alt);
  }
  .site-nav__link.is-active {
    box-shadow: inset 0 -2px 0 var(--c-accent);
  }
  .site-nav__caret {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-left: -0.35rem;
    color: var(--c-text-muted);
    border-radius: 50%;
    transition: transform var(--dur) var(--ease);
  }
  .has-children:hover .site-nav__caret,
  .has-children:focus-within .site-nav__caret,
  .site-nav__caret[aria-expanded='true'] {
    transform: rotate(180deg);
  }

  .site-nav__sub {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    min-width: 15rem;
    padding: 0.5rem;
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease), visibility 0s linear var(--dur);
  }
  .has-children:hover .site-nav__sub,
  .has-children:focus-within .site-nav__sub,
  .has-children.is-open .site-nav__sub {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .site-nav__sublink {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .site-nav__sublink:hover,
  .site-nav__sublink.is-active {
    background: var(--c-bg-alt);
  }
  .ext {
    color: var(--c-text-muted);
    font-size: 0.8em;
  }

  .nav-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 10px;
    border: 1px solid var(--c-border);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }
  .nav-toggle__bar {
    width: 18px;
    height: 2px;
    background: var(--c-text);
    border-radius: 2px;
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile nav */
  @media (max-width: 1023px) {
    .nav-toggle { display: flex; }
    .site-nav {
      position: fixed;
      inset: var(--header-h-compact) 0 0 0;
      flex-direction: column;
      align-items: stretch;
      gap: var(--sp-30);
      padding: var(--sp-30) var(--gutter) var(--sp-60);
      background: var(--c-bg);
      overflow-y: auto;
      transform: translateX(100%);
      visibility: hidden;
      transition: transform var(--dur) var(--ease), visibility 0s linear var(--dur);
    }
    .site-nav.is-open {
      transform: none;
      visibility: visible;
      transition-delay: 0s;
    }
    .site-header__inner { min-height: var(--header-h-compact); }
    .site-nav__list { flex-direction: column; align-items: stretch; gap: 0; }
    .site-nav__item { flex-wrap: wrap; border-bottom: 1px solid var(--c-border); }
    .site-nav__link { flex: 1; padding: 1rem 0.25rem; font-size: 1.125rem; border-radius: 0; }
    .site-nav__link:hover, .site-nav__link.is-active { background: none; }
    .site-nav__caret { width: 2.75rem; height: 2.75rem; margin: 0; }
    .site-nav__sub {
      position: static;
      display: none;
      width: 100%;
      min-width: 0;
      padding: 0 0 0.75rem 0.5rem;
      border: 0;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .has-children.is-open .site-nav__sub { display: block; }
    .has-children:hover .site-nav__sub:not(.is-open) { display: none; }
    .has-children.is-open .site-nav__sub { display: block; }
    .site-nav__sublink { white-space: normal; padding: 0.7rem 0.5rem; }
    .site-nav__cta { align-self: flex-start; }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');

  // Compact header after a little scroll.
  const onScroll = () => header?.classList.toggle('is-compact', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu.
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    nav?.classList.toggle('is-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  });

  // Submenu buttons (touch and keyboard).
  document.querySelectorAll<HTMLButtonElement>('.site-nav__caret').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.has-children');
      const open = btn.getAttribute('aria-expanded') !== 'true';
      document.querySelectorAll('.has-children.is-open').forEach((el) => {
        if (el !== item) {
          el.classList.remove('is-open');
          el.querySelector('.site-nav__caret')?.setAttribute('aria-expanded', 'false');
        }
      });
      btn.setAttribute('aria-expanded', String(open));
      item?.classList.toggle('is-open', open);
    });
  });

  // Close open submenus on outside click or Escape.
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.has-children')) {
      document.querySelectorAll('.has-children.is-open').forEach((el) => {
        el.classList.remove('is-open');
        el.querySelector('.site-nav__caret')?.setAttribute('aria-expanded', 'false');
      });
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.has-children.is-open').forEach((el) => el.classList.remove('is-open'));
      if (nav?.classList.contains('is-open')) toggle?.click();
    }
  });
</script>
