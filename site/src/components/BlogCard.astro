---
import { Image } from 'astro:assets';
import { categoryHref, categoryLabel, excerpt, formatDate, isoDate, postHref, primaryCategory, readingTime, type Post } from '../lib/posts';

interface Props {
  post: Post;
  eager?: boolean;
  showExcerpt?: boolean;
}
const { post, eager = false, showExcerpt = true } = Astro.props;
const category = primaryCategory(post);
---

<article class="blog-card card reveal">
  <a class="blog-card__media" href={postHref(post)} tabindex="-1" aria-hidden="true">
    {
      post.data.coverImage ? (
        <Image
          src={post.data.coverImage}
          alt=""
          widths={[400, 640, 900]}
          sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 380px"
          loading={eager ? 'eager' : 'lazy'}
        />
      ) : (
        <div class="blog-card__placeholder">{post.data.title.slice(0, 1)}</div>
      )
    }
  </a>
  <div class="blog-card__body">
    <div class="blog-card__meta">
      {category && <a class="chip" href={categoryHref(category)}>{categoryLabel(category)}</a>}
      <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
      <span>{readingTime(post.body)} min read</span>
    </div>
    <h3 class="blog-card__title"><a href={postHref(post)}>{post.data.title}</a></h3>
    {showExcerpt && <p class="blog-card__excerpt">{excerpt(post)}</p>}
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  .blog-card__media {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--c-bg-alt);
    overflow: hidden;
  }
  .blog-card__media img,
  .blog-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease);
  }
  .blog-card:hover .blog-card__media img { transform: scale(1.03); }
  .blog-card__placeholder {
    display: grid;
    place-items: center;
    font-size: 3rem;
    font-weight: 800;
    color: var(--c-accent);
  }
  .blog-card__body { display: grid; gap: 0.75rem; padding: var(--sp-30) var(--sp-30) var(--sp-40); }
  .blog-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    font-size: var(--fs-micro);
    color: var(--c-text-muted);
  }
  .chip {
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--c-accent-soft);
    color: var(--c-accent-ink);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }
  .chip:hover { background: var(--c-accent); color: var(--c-black); }
  .blog-card__title { font-size: var(--fs-small-plus); line-height: 1.25; }
  .blog-card__title a:hover { color: var(--c-accent-ink); }
  .blog-card__excerpt { font-size: var(--fs-tiny); color: var(--c-text-muted); }
</style>
