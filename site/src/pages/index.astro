---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, services } from '../lib/site';
import { href } from '../lib/url';
import portrait from '../assets/portraits/woody-head-1000.png';

const typedWords = ['effortlessly.', 'at scale.', 'in court.', 'with AI agents.', 'for year five.'];
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__content">
        <span class="label reveal">{site.roles.join(' · ')}</span>
        <h1 class="hero__title reveal">
          Designing solutions that work
          <span class="hero__typed" data-words={JSON.stringify(typedWords)} aria-live="polite">
            <span class="mark">{typedWords[0]}</span>
          </span>
        </h1>
        <p class="lead reveal">
          I help teams untangle complexity in software systems, whether that means modernizing aging platforms,
          scaling cloud-native solutions, making a platform work for AI coding agents, or explaining technical
          decisions in high-stakes legal cases.
        </p>
        <div class="hero__actions reveal">
          <a class="btn" href={href('/contact/')}>Let's work <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--outline" href={href(site.resume)} download>Download CV</a>
        </div>
        <ul class="hero__social reveal" role="list" aria-label="Social links">
          <li><a href={site.social.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href={site.social.github} target="_blank" rel="noopener">GitHub</a></li>
          <li><a href={site.social.youtube} target="_blank" rel="noopener">YouTube</a></li>
          <li><a href={site.social.podcast} target="_blank" rel="noopener">Podcast</a></li>
        </ul>
      </div>
      <div class="hero__media reveal">
        <div class="hero__shape"></div>
        <Image
          src={portrait}
          alt="Chris Woody Woodruff"
          widths={[320, 480, 640, 960]}
          sizes="(max-width: 900px) 70vw, 460px"
          loading="eager"
          fetchpriority="high"
          class="hero__photo"
        />
      </div>
    </div>
  </section>

  <!-- Build status (Phase 0 placeholder) -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header reveal">
        <span class="label">Under construction</span>
        <h2>The new woodruff.dev is being built in the open.</h2>
        <p class="lead">
          This is the Phase 0 scaffold: design tokens, typography, navigation, and deployment. Content, the blog
          archive, Portfolio, Press &amp; Media, and Training arrive in the next phases.
        </p>
      </div>
      <div class="grid grid--3">
        {
          services.map((s, i) => (
            <a class="card service reveal" href={href(`/services/${s.slug}/`)}>
              <span class="service__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.name}</h3>
              <span class="link-arrow">Learn more <span aria-hidden="true">→</span></span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero {
    padding-block: var(--sp-60) var(--sp-80);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: var(--sp-60);
  }
  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__media { order: -1; max-width: 420px; }
  }
  .hero__content { display: grid; gap: var(--sp-30); justify-items: start; }
  .hero__title { font-size: var(--fs-gigantic); }
  .hero__typed { display: block; min-height: 1.1em; }
  .hero__typed .caret {
    display: inline-block;
    width: 0.06em;
    height: 0.9em;
    margin-left: 0.08em;
    background: var(--c-accent-ink);
    vertical-align: -0.08em;
    animation: blink 1s steps(2, start) infinite;
  }
  @keyframes blink { to { visibility: hidden; } }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--sp-20); }
  .hero__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: var(--fs-tiny);
    font-weight: 700;
  }
  .hero__social a { text-decoration: underline; text-underline-offset: 0.2em; }
  .hero__social a:hover { color: var(--c-accent-ink); }

  .hero__media {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 1;
  }
  .hero__shape {
    position: absolute;
    inset: 8% 4% 0 4%;
    background: var(--c-accent);
    border-radius: 48% 48% var(--radius) var(--radius);
  }
  .hero__photo {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    border-radius: 48% 48% var(--radius) var(--radius);
  }

  .service { display: grid; gap: var(--sp-20); align-content: start; }
  .service__num {
    font-size: var(--fs-micro);
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--c-accent-ink);
  }
</style>

<script>
  // Typed rotating word in the hero. Respects prefers-reduced-motion.
  const el = document.querySelector<HTMLElement>('.hero__typed');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reduce) {
    const words: string[] = JSON.parse(el.dataset.words ?? '[]');
    const mark = document.createElement('span');
    mark.className = 'mark';
    const caret = document.createElement('span');
    caret.className = 'caret';
    caret.setAttribute('aria-hidden', 'true');
    el.replaceChildren(mark, caret);

    let w = 0;
    let i = words[0].length;
    let deleting = false;
    mark.textContent = words[0];

    const tick = () => {
      const word = words[w];
      if (!deleting && i < word.length) {
        i += 1;
      } else if (!deleting && i === word.length) {
        deleting = true;
        setTimeout(tick, 1800);
        return;
      } else if (deleting && i > 0) {
        i -= 1;
      } else {
        deleting = false;
        w = (w + 1) % words.length;
      }
      mark.textContent = words[w].slice(0, i);
      setTimeout(tick, deleting ? 45 : 85);
    };
    setTimeout(tick, 1800);
  }
</script>
