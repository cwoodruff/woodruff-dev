---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import FilterTabs from '../../components/FilterTabs.astro';

const items = (await getCollection('portfolio')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order,
);
---

<Page
  title="Portfolio"
  description="Books, websites, open-source components, a newsletter, and a podcast by Chris Woody Woodruff."
  label="Portfolio"
  heading="Books, sites & shows"
  text="The books I've written, the sites and tools I've built around them, and the places I write and talk every week."
  cta={{ heading: 'Got an idea worth building?', text: "If any of this work resonates, let's talk about what we could build together.", buttonText: 'Get in touch' }}
>
  <section class="section">
    <div class="container">
      <FilterTabs
        label="Portfolio filters"
        target="#portfolio-grid"
        tabs={[
          { key: 'books', label: 'Books' },
          { key: 'projects', label: 'Sites & Apps' },
          { key: 'shows', label: 'Podcast & Newsletter' },
        ]}
      />
      <div class="grid grid--3" id="portfolio-grid">
        {items.map((item) => <ProjectCard item={item} />)}
      </div>
    </div>
  </section>
</Page>
