---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { site } from '../lib/site';
import { href } from '../lib/url';
import head from '../assets/portraits/woody-head.webp';
import mvp from '../assets/badges/microsoft-mvp-2025.png';
import jbcc from '../assets/badges/jetbrains-jbcc.png';

const tabs = [
  {
    id: 'mission',
    label: 'My Mission',
    heading: 'To simplify the complex and empower others through clear, strategic software architecture and honest technical insight.',
    text: "Whether I'm advising a team, reviewing a system, or testifying in court, my mission is to bring clarity, value, and forward momentum to every challenge I take on.",
  },
  {
    id: 'vision',
    label: 'My Vision',
    heading: 'To be the trusted expert that teams, leaders, and legal professionals turn to when software decisions, and disputes, really matter.',
    text: "I envision a world where great architecture is accessible, where legacy doesn't mean liability, and where technical truth can be clearly communicated and confidently acted upon.",
  },
  {
    id: 'goal',
    label: 'My Goal',
    heading: 'To deliver meaningful impact through every project, consult, or conversation.',
    text: 'I do this by showing that thoughtful architecture, expert guidance, and simplicity-first thinking lead to lasting success.',
  },
];

const credentials = site.credentials;
const books = (await getCollection('portfolio', ({ data }) => data.category === 'book')).sort((a, b) => a.data.order - b.data.order);
const career = [
  { org: 'Woody Technology Studio', role: 'Founder', text: 'My independent practice: fractional architecture, advisory, expert witness work, and agentic AI systems for regulated and enterprise environments.' },
  { org: 'Real Time Technologies', role: 'Senior Solution Architect', text: 'A multi-tenant Azure platform built as a modular monolith, with infrastructure cost cut 35% at a 99.9% uptime SLA.' },
  { org: 'Rocket Homes', role: 'Engineering Team Leader', text: 'Replaced point-to-point integrations with an event-driven Kafka platform and raised availability from 95% to 99.8%.' },
  { org: 'Rocket Mortgage', role: 'Team Leader, Developer Relations', text: 'Built Developer Relations from scratch for a 200+ engineer organization and cut new-engineer ramp-up time by 42%.' },
  { org: 'JetBrains', role: 'Developer Advocate', text: 'Brought ReSharper and Rider to .NET developers across North America through 50+ conference talks a year.' },
  { org: 'Eidex', role: 'Principal Architect', text: 'Led the team behind an analytics platform serving more than 1,500 K-12 school districts.' },
  { org: 'Enterprise consulting', role: 'Architect', text: 'Systems for Microsoft, MLB Advanced Media, and Fortune 500 clients, including web apps serving 1M+ concurrent users.' },
];
---

<Page
  title="About"
  description="Chris Woody Woodruff: 25+ years simplifying complex software as an architect, Microsoft MVP, author, podcast host, and software forensic expert witness."
  label="About"
  heading="Chris Woody Woodruff"
  text={site.roles.join(' · ')}
  cta={{ heading: 'Ready to work together?', text: "Whether you need architectural guidance, expert testimony, or strategic advice, let's talk.", buttonText: 'Get in touch' }}
>
  <section class="section">
    <div class="container about__grid">
      <div class="about__photo reveal reveal--left">
        <Image src={head} alt="Chris Woody Woodruff" widths={[360, 540, 720]} sizes="(max-width: 900px) 70vw, 420px" loading="eager" />
        <ul class="about__badges" role="list" aria-label="Credentials">
          <li><Image src={mvp} alt="Microsoft MVP 2025" width={80} height={80} /></li>
          <li><Image src={jbcc} alt="JetBrains Community Contributor" width={80} height={80} /></li>
        </ul>
      </div>

      <div class="about__content reveal">
        <div class="tabs" role="tablist" aria-label="Mission, vision, and goal">
          {
            tabs.map((t, i) => (
              <button
                class:list={['tab', { 'is-active': i === 0 }]}
                type="button"
                role="tab"
                id={`tab-${t.id}`}
                aria-controls={`panel-${t.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {t.label}
              </button>
            ))
          }
        </div>
        {
          tabs.map((t, i) => (
            <div class="panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
              <h2 class="panel__heading">{t.heading}</h2>
              <p class="lead">{t.text}</p>
            </div>
          ))
        }

        <dl class="about__contact">
          <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div><dt>Phone</dt><dd><a href={site.phoneHref}>{site.phone}</a></dd></div>
          <div><dt>Location</dt><dd>{site.location}</dd></div>
        </dl>
        <p class="about__actions">
          <a class="btn" href={href(site.resume)} download>Download CV</a>
          <a class="btn btn--outline" href={href('/contact/')}>Get in touch</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container about__bio">
      <SectionHeader label="Bio" title="My journey in the world of software architecture" />
      <div class="prose reveal">
        <p>
          I've been building software since before the first .COM boom. Twenty-five years of enterprise web development,
          cloud platforms, software analytics, and developer relations have left me with one strong conviction: complexity
          is the default failure mode of software, and simplicity has to be chosen on purpose.
        </p>
        <p>
          Today I work independently as a fractional architect, strategic advisor, and software forensic expert witness. I
          help teams make the architecture calls that are too consequential for the loudest voice in the room, give boards
          and founders an independent technical read, and explain what code actually did to attorneys, judges, and juries.
          I'm a Microsoft MVP in .NET and Web Development, first awarded in 2008 and re-awarded in 2025, and I serve on the
          board of the .NET Foundation.
        </p>
        <p>
          I also write and teach. My books cover Simplicity-First architecture, htmx with ASP.NET Core, C# network
          programming, and developer relations, and my current focus
          is <a href="https://agenticairelations.com/" target="_blank" rel="noopener">Agentic Developer Relations</a>, a
          discipline I named: making APIs, documentation, and SDKs work for the AI coding agents that now write a growing
          share of every integration. As AI writes more of the world's software, the scarce skill is knowing what not to
          build. I've given more than fifty conference talks across North America and Europe, designed bootcamp curriculum
          that helped people move into tech careers, and co-host <strong>The Breakpoint Show</strong>.
        </p>
        <p>
          Outside of tech I'm an avid bourbon enthusiast (neat, please), often out on the Bourbon Trail looking for unique
          bottles to share with friends. I live in West Michigan and write about tech and life on this blog. You can find me
          on <a href={site.social.bluesky} target="_blank" rel="noopener">Bluesky</a> and <a href={site.social.mastodon} target="_blank" rel="noopener me">Mastodon</a>.
        </p>
        <p class="about__press">
          Writing about me or introducing me at an event? The <a href={href('/press-media/#press-kit')}>press kit</a> has
          third-person bios and photos ready to use.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader label="Books" title="Books I've written" />
      <ul class="books" role="list">
        {
          books.map((b) => (
            <li class="reveal">
              <a class="book" href={href(`/portfolio/${b.id}/`)}>
                <span class="book__cover">
                  {b.data.image && <Image src={b.data.image} alt="" widths={[240, 480]} sizes="200px" loading="lazy" />}
                </span>
                <span class="book__title">{b.data.title}</span>
                {b.data.year && <span class="book__year">{b.data.year}</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <SectionHeader label="Career" title="Where I've done the work" />
      <ol class="career" role="list">
        {
          career.map((c) => (
            <li class="career__item reveal">
              <span class="career__org">{c.org}</span>
              <span class="career__role">{c.role}</span>
              <p>{c.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader label="Credentials" title="At a glance" />
      <ul class="credentials grid grid--2" role="list">
        {credentials.map((c) => <li class="credentials__item reveal">{c}</li>)}
      </ul>
    </div>
  </section>
</Page>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--sp-60);
    align-items: start;
  }
  @media (max-width: 900px) { .about__grid { grid-template-columns: 1fr; } }
  .about__photo { position: relative; justify-self: center; width: 100%; max-width: 420px; }
  .about__photo > img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); background: var(--c-accent-soft); }
  .about__badges { position: absolute; right: -0.75rem; bottom: -0.75rem; display: flex; gap: 0.5rem; }
  .about__badges li {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    padding: 0.35rem;
    background: var(--c-bg);
    border-radius: 50%;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }
  .about__badges img { width: 100%; height: 100%; object-fit: contain; border-radius: 50%; }

  .about__content { display: grid; gap: var(--sp-30); }
  .tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tab {
    padding: 0.55rem 1.1rem;
    border: 1.5px solid var(--c-border);
    border-radius: var(--radius-pill);
    font-size: var(--fs-tiny);
    font-weight: 700;
  }
  .tab:hover { border-color: var(--c-text); }
  .tab.is-active { background: var(--c-text); border-color: var(--c-text); color: var(--c-white); }
  .panel { display: grid; gap: var(--sp-20); }
  .panel__heading { font-size: var(--fs-medium-plus); }

  .about__contact { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--sp-20); }
  .about__contact dt { font-size: var(--fs-micro); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-text-muted); }
  .about__contact dd { font-weight: 600; }
  .about__contact a:hover { color: var(--c-accent-ink); }
  .about__actions { display: flex; flex-wrap: wrap; gap: var(--sp-20); }

  .about__bio .prose { max-width: 760px; }
  .about__press { padding-top: var(--sp-20); border-top: 1px solid var(--c-border); color: var(--c-text-muted); }

  .books { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--sp-40); }
  @media (max-width: 900px) { .books { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .book { display: grid; gap: var(--sp-10); align-content: start; }
  .book__cover { position: relative; aspect-ratio: 4 / 5; background: var(--c-accent-soft); border-radius: var(--radius); }
  .book__cover img {
    position: absolute;
    inset: 0;
    margin: auto;
    width: auto;
    height: auto;
    max-width: calc(100% - 2 * var(--sp-30));
    max-height: calc(100% - 2 * var(--sp-30));
    border-radius: 4px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
    transition: transform var(--dur) var(--ease);
  }
  .book:hover .book__cover img { transform: translateY(-4px); }
  .book__title { font-weight: 700; line-height: var(--lh-snug); }
  .book:hover .book__title { color: var(--c-accent-ink); }
  .book__year { font-size: var(--fs-micro); color: var(--c-text-muted); }

  .career { display: grid; gap: 0; max-width: 860px; border-left: 2px solid var(--c-border); }
  .career__item { position: relative; display: grid; gap: 0.25rem; padding: 0 0 var(--sp-40) var(--sp-40); }
  .career__item:last-child { padding-bottom: 0; }
  .career__item::before {
    content: '';
    position: absolute;
    left: calc(-0.5rem - 1px);
    top: 0.3em;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--c-bg-alt);
    border: 3px solid var(--c-accent);
  }
  .career__item:first-child::before { background: var(--c-accent); }
  .career__org { font-size: var(--fs-small); font-weight: 800; }
  .career__role { font-size: var(--fs-micro); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-accent-ink); }
  .career__item p { color: var(--c-text-muted); max-width: 680px; }

  .credentials__item {
    position: relative;
    padding: var(--sp-20) 0 var(--sp-20) 2rem;
    border-bottom: 1px solid var(--c-border);
    font-weight: 600;
  }
  .credentials__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: calc(var(--sp-20) + 0.55em);
    width: 1rem;
    height: 3px;
    border-radius: 2px;
    background: var(--c-accent);
  }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tab')];
  const panels = [...document.querySelectorAll<HTMLElement>('.panel')];
  const activate = (i: number) => {
    tabs.forEach((t, j) => {
      t.classList.toggle('is-active', i === j);
      t.setAttribute('aria-selected', String(i === j));
      t.tabIndex = i === j ? 0 : -1;
    });
    panels.forEach((p, j) => (p.hidden = i !== j));
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => activate(i));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        const next = (i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
        activate(next);
        tabs[next].focus();
      }
    });
  });
</script>
