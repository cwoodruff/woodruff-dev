---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { formatDate, isoDate } from '../../lib/posts';
import { href } from '../../lib/url';

export async function getStaticPaths() {
  const items = (await getCollection('training', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const { data } = item;
const fmt: Record<string, string> = { workshop: 'Workshop', course: 'Course', bootcamp: 'Bootcamp' };
const upcoming = data.nextDates.filter((d) => d.date.valueOf() >= Date.now() - 86400000);
---

<Page
  title={data.title}
  description={data.short}
  label={[fmt[data.format], data.duration, data.level].filter(Boolean).join(' · ')}
  heading={data.title}
  text={data.short}
  cta={{ label: 'Private delivery', heading: 'Bring this to your team.', text: 'Delivered on site or remote and tailored to your codebase.', buttonText: 'Request a private session' }}
>
  <article class="section">
    <div class="container course" style={`--course-accent:${data.accent ?? 'var(--c-accent)'}`}>
      <div class="course__main">
        {
          data.image && (
            <div class="course__image reveal">
              <Image src={data.image} alt="" widths={[640, 960, 1280]} sizes="(max-width: 1000px) 92vw, 760px" />
            </div>
          )
        }

        <div class="prose reveal"><Content /></div>

        {
          data.build && (
            <section class="course__build reveal">
              <span class="label">What you'll build</span>
              <p>{data.build}</p>
            </section>
          )
        }

        {
          data.outcomes.length > 0 && (
            <section class="reveal">
              <h2 class="course__h2">What you'll be able to do</h2>
              <ul class="course__outcomes" role="list">
                {data.outcomes.map((o) => (
                  <li>{o}</li>
                ))}
              </ul>
            </section>
          )
        }

        <section class="reveal">
          <h2 class="course__h2">Who it's for</h2>
          <p class="lead">{data.audience}</p>
        </section>

        {
          data.prerequisites.length > 0 && (
            <section class="reveal">
              <h2 class="course__h2">Prerequisites</h2>
              <ul class="course__list">
                {data.prerequisites.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          data.modules.length > 0 && (
            <section class="reveal">
              <h2 class="course__h2">Agenda</h2>
              <ol class="course__modules" role="list">
                {data.modules.map((m, i) => (
                  <li>
                    <span class="course__num">{String(i + 1).padStart(2, '0')}</span>
                    <span class="course__module">{m.title}</span>
                    {m.length && <span class="course__len">{m.length}</span>}
                  </li>
                ))}
              </ol>
            </section>
          )
        }
      </div>

      <aside class="course__aside">
        <div class="card course__card reveal">
          <dl class="course__facts">
            <div><dt>Format</dt><dd>{fmt[data.format]}</dd></div>
            {data.duration && <div><dt>Length</dt><dd>{data.duration}</dd></div>}
            <div><dt>Level</dt><dd class="course__level">{data.level}</dd></div>
            {data.modules.length > 0 && <div><dt>Modules</dt><dd>{data.modules.length}</dd></div>}
          </dl>
          {
            data.tech.length > 0 && (
              <ul class="course__tech" role="list">
                {data.tech.map((x) => (
                  <li>{x}</li>
                ))}
              </ul>
            )
          }
          {
            data.site && (
              <a class="btn btn--block" href={data.site} target="_blank" rel="noopener">
                Open the workshop guide <span aria-hidden="true">↗</span>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            )
          }
          {
            data.repo && (
              <a class="course__repo" href={data.repo} target="_blank" rel="noopener">
                Source code on GitHub <span aria-hidden="true">↗</span>
              </a>
            )
          }
        </div>
        <div class="card course__card course__card--plain reveal">
          <span class="label">Upcoming dates</span>
          {
            upcoming.length === 0 ? (
              <p>No public dates scheduled. Private delivery is available now.</p>
            ) : (
              <ul class="course__dates" role="list">
                {upcoming.map((d) => (
                  <li>
                    <time datetime={isoDate(d.date)}>{formatDate(d.date)}</time>
                    <span>{d.city}</span>
                    {d.url && (
                      <a href={d.url} target="_blank" rel="noopener">
                        Register ↗
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            )
          }
          <a class:list={['btn btn--block', { 'btn--outline': data.site }]} href={href('/contact/')}>Request a private session <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </aside>
    </div>
  </article>
</Page>

<style>
  .course { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: var(--sp-60); align-items: start; }
  @media (max-width: 1000px) { .course { grid-template-columns: 1fr; } }
  .course__main { display: grid; gap: var(--sp-60); max-width: 760px; }
  .course__h2 { font-size: var(--fs-medium-plus); margin-bottom: var(--sp-20); }
  .course__list { padding-left: 1.3em; display: grid; gap: 0.4rem; }
  .course__modules { display: grid; }
  .course__modules li {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--c-border);
  }
  .course__num { font-weight: 800; color: var(--course-accent); font-size: var(--fs-micro); letter-spacing: 0.08em; }
  .course__module { font-weight: 600; }
  .course__len { font-size: var(--fs-micro); color: var(--c-text-muted); white-space: nowrap; }
  .course__aside { position: sticky; top: calc(var(--header-h-compact) + 1.5rem); display: grid; gap: var(--sp-30); }
  .course__card { display: grid; gap: var(--sp-20); border-top: 6px solid var(--course-accent); }
  .course__card:hover { transform: none; border-color: var(--c-border); border-top-color: var(--course-accent); }
  .course__card p { font-size: var(--fs-tiny); color: var(--c-text-muted); }
  .course__card--plain { border-top-width: 1px; border-top-color: var(--c-border); }
  .course__card--plain:hover { border-top-color: var(--c-border); }
  .course__image img { width: 100%; height: auto; border-radius: var(--radius); }
  .course__build { display: grid; gap: var(--sp-10); padding: var(--sp-40); border-left: 6px solid var(--course-accent); background: var(--c-bg-alt); border-radius: var(--radius-sm); }
  .course__build p { font-size: var(--fs-small); line-height: var(--lh-snug); }
  .course__outcomes { display: grid; gap: 0.75rem; }
  .course__outcomes li { position: relative; padding-left: 2rem; }
  .course__outcomes li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0.05em;
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: var(--course-accent);
    color: var(--c-white);
    font-size: 0.75rem;
    font-weight: 800;
  }
  .course__facts { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-20); }
  .course__facts dt { font-size: var(--fs-micro); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-text-muted); }
  .course__facts dd { font-weight: 700; }
  .course__level { text-transform: capitalize; }
  .course__tech { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .course__tech li { padding: 0.2rem 0.6rem; border: 1px solid var(--c-border); border-radius: var(--radius-pill); font-size: 0.72rem; font-weight: 600; color: var(--c-text-muted); }
  .course__repo { font-size: var(--fs-tiny); font-weight: 700; justify-self: center; }
  .course__repo:hover { color: var(--course-accent); }
  .course__dates { display: grid; gap: 0.75rem; }
  .course__dates li { display: grid; gap: 0.15rem; font-size: var(--fs-tiny); }
  .course__dates time { font-weight: 700; }
</style>
