---
import Page from '../../../layouts/Page.astro';
import BlogListing from '../../../components/BlogListing.astro';
import { getPosts, POSTS_PER_PAGE } from '../../../lib/posts';
import { href } from '../../../lib/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  const total = Math.ceil(posts.length / POSTS_PER_PAGE);
  const paths = [];
  for (let p = 2; p <= total; p++) {
    paths.push({
      params: { page: String(p) },
      props: { posts: posts.slice((p - 1) * POSTS_PER_PAGE, p * POSTS_PER_PAGE), current: p, total },
    });
  }
  return paths;
}

const { posts, current, total } = Astro.props;
const urlFor = (p: number) => (p === 1 ? href('/blog/') : href(`/blog/page/${p}/`));
---

<Page
  title={`Blog & Insights, page ${current}`}
  description="Articles on .NET, C#, EF Core, htmx, Rust, Terraform, distributed systems, enterprise patterns, and software architecture by Chris Woody Woodruff."
  label="Blog & Insights"
  heading="Latest articles and insights"
  text={`Page ${current} of ${total}.`}
  cta={false}
>
  <BlogListing
    posts={posts}
    current={current}
    total={total}
    prevUrl={urlFor(current - 1)}
    nextUrl={current < total ? urlFor(current + 1) : undefined}
    urlFor={urlFor}
  />
</Page>
