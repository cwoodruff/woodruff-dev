---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { getPosts, primaryCategory } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => {
    const cat = primaryCategory(post);
    const related = posts
      .filter((p) => p.id !== post.id && cat && p.data.categories.includes(cat))
      .sort((a, b) => Math.abs(a.data.date.valueOf() - post.data.date.valueOf()) - Math.abs(b.data.date.valueOf() - post.data.date.valueOf()))
      .slice(0, 3);
    return {
      params: { slug: post.id },
      props: { post, next: posts[i - 1], prev: posts[i + 1], related },
    };
  });
}

const { post, prev, next, related } = Astro.props;
const { Content } = await render(post);
---

<Post post={post} prev={prev} next={next} related={related}>
  <Content />
</Post>
